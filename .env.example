# YouTube Data API v3 Key (wajib untuk mengambil data channel, video, dan komentar publik)
# Dapatkan gratis di Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY="YOUR_YOUTUBE_DATA_API_V3_KEY"

# Port server Express (default 3000)
PORT=3000

# Jadwal cron bot pengecek otomatis (default: tiap 10 menit)
# Format cron 5-kolom: menit jam tanggal bulan hari
CHECK_INTERVAL="*/10 * * * *"

# Path file database SQLite (opsional, default: ./data/tracker.db)
DB_PATH="./data/tracker.db"
